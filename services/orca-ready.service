[Unit]
Description=Orca OS boot readiness marker
After=orca-core-ready.service network-online.target
Wants=network-online.target
Requires=orca-core-ready.service

[Service]
Type=oneshot
ExecStart=/usr/bin/printf ORCA_OS_READY
StandardOutput=journal+console
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
