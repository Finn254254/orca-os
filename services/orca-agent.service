[Unit]
Description=Orca node agent
Documentation=https://github.com/Finn254254/orca-os
After=orca-first-boot.service
Wants=orca-first-boot.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/lib/orca/orca-agent
Group=orca-api
Restart=on-failure
RestartSec=5
OOMPolicy=stop
MemoryAccounting=true
CPUAccounting=true
TasksMax=8
LimitNOFILE=64
RuntimeDirectory=orca
RuntimeDirectoryMode=0750
StateDirectory=orca
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/orca
ReadWritePaths=/var/lib/orca

[Install]
WantedBy=multi-user.target
