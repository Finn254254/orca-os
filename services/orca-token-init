#!/usr/bin/env python3
"""Create and validate Orca's persistent API bearer token."""

import argparse
import os
import re
import secrets
import stat
import sys
from pathlib import Path


TOKEN_PATTERN = re.compile(r"^[0-9a-f]{64}$")


def validate(path: Path) -> None:
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    with os.fdopen(descriptor, "r", encoding="ascii") as token_stream:
        if not stat.S_ISREG(os.fstat(token_stream.fileno()).st_mode):
            raise ValueError(f"Orca API token is not a regular file: {path}")
        token = token_stream.read(258)
        if token.endswith("\n"):
            token = token[:-1]
            if token.endswith("\r"):
                token = token[:-1]
        if not TOKEN_PATTERN.fullmatch(token):
            raise ValueError(f"invalid Orca API token in {path}")
        os.fchmod(token_stream.fileno(), 0o640)


def write_token(path: Path, *, exclusive: bool) -> None:
    flags = os.O_WRONLY | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
    if exclusive:
        flags |= os.O_EXCL
    descriptor = os.open(path, flags, 0o640)
    try:
        with os.fdopen(descriptor, "w", encoding="ascii") as output:
            output.write(secrets.token_hex(32) + "\n")
            output.flush()
            os.fsync(output.fileno())
    except BaseException:
        path.unlink(missing_ok=True)
        raise


def sync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def main() -> int:
    parser = argparse.ArgumentParser(description="Initialize an Orca API token")
    parser.add_argument("--rotate", action="store_true", help="atomically replace an existing token")
    parser.add_argument("path", nargs="?", default="/var/lib/orca/api-token")
    args = parser.parse_args()
    path = Path(args.path)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not args.rotate:
        try:
            write_token(path, exclusive=True)
        except FileExistsError:
            try:
                validate(path)
            except (OSError, UnicodeError, ValueError) as error:
                print(error, file=sys.stderr)
                return 1
            return 0
        sync_directory(path.parent)
        return 0

    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        write_token(temporary, exclusive=True)
        os.replace(temporary, path)
        sync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
