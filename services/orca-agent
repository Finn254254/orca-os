#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${ORCA_RUNTIME_DIR:-/run/orca}"
state_dir="${ORCA_STATE_DIR:-/var/lib/orca}"
interval="${ORCA_AGENT_INTERVAL:-30}"

umask 077
mkdir -p "$runtime_dir" "$state_dir"
node_id_file="$state_dir/node-id"

if [[ -n "${ORCA_NODE_ID:-}" ]]; then
  node_id="$ORCA_NODE_ID"
elif [[ -r "$node_id_file" ]]; then
  node_id="$(cat "$node_id_file")"
else
  node_id="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || hostname)"
  printf '%s\n' "$node_id" > "$node_id_file"
fi

write_status() {
  local hostname architecture kernel updated
  hostname="$(hostname)"
  architecture="$(uname -m)"
  kernel="$(uname -r)"
  updated="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  cat > "$runtime_dir/agent.status" <<EOF
Agent: active
Node ID: $node_id
Hostname: $hostname
Updated: $updated
EOF
  cat > "$runtime_dir/node.json" <<EOF
{"schemaVersion":1,"nodeId":"$node_id","hostname":"$hostname","architecture":"$architecture","kernel":"$kernel","agent":"active","updated":"$updated"}
EOF
}

trap 'rm -f "$runtime_dir/agent.status"; exit 0' TERM INT
while true; do
  write_status
  sleep "$interval" & wait $!
done
