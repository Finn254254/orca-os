#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${ORCA_RUNTIME_DIR:-/run/orca}"
interval="${ORCA_AGENT_INTERVAL:-30}"

mkdir -p "$runtime_dir"
node_id="${ORCA_NODE_ID:-$(cat /etc/machine-id 2>/dev/null || hostname)}"

write_status() {
  cat > "$runtime_dir/agent.status" <<EOF
Agent: active
Node ID: $node_id
Hostname: $(hostname)
Updated: $(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
}

trap 'rm -f "$runtime_dir/agent.status"; exit 0' TERM INT
while true; do
  write_status
  sleep "$interval" & wait $!
done
